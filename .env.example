# App Settings
PROJECT_NAME="Document RAG Backend"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8001

# PostgreSQL Settings (DATABASE_URL is dynamically assembled if omitted)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=app_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Settings (REDIS_URL is dynamically assembled if omitted)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CHAT_MEMORY_TTL_SECONDS=86400
MAX_CHAT_TURNS=10

# Qdrant Settings
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=documents
# Set QDRANT_VECTOR_SIZE to match your embedding model:
#   gemini-embedding-001 -> 3072
#   text-embedding-004   -> 768
#   text-embedding-3-small -> 1536
QDRANT_VECTOR_SIZE=3072

# LLM & Embedding Provider Settings (Primary - OpenAI Compatible API)
# The backend uses the standard OpenAI-compatible client, allowing you to easily
# switch between Gemini, OpenAI, Groq, or local Ollama by changing these variables:
#
# Option 1: Google Gemini (Recommended - Free Tier API)
#   OPENAI_API_KEY=your_gemini_api_key
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_MODEL=gemini-2.0-flash
#   OPENAI_EMBEDDING_MODEL=gemini-embedding-001
#   QDRANT_VECTOR_SIZE=3072
#
# Option 2: OpenAI (Official ChatGPT)
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o-mini
#   OPENAI_EMBEDDING_MODEL=text-embedding-3-small
#   QDRANT_VECTOR_SIZE=1536
#
# Option 3: Groq Cloud (Ultra-fast Llama 3)
#   OPENAI_API_KEY=gsk_...
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.1-70b-versatile
#
# Option 4: Local Ollama
#   OPENAI_API_KEY=ollama
#   OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#   OPENAI_MODEL=llama3.1

OPENAI_API_KEY=your_openai_or_gemini_api_key_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-2.0-flash
OPENAI_EMBEDDING_MODEL=gemini-embedding-001

# Local Fallback LLM Settings (vLLM / Ollama)
# Automatically used when primary LLM fails or hits rate limits (429)
# Use http://host.docker.internal:8002/v1 when running inside Docker container
VLLM_BASE_URL=http://host.docker.internal:8002/v1
LOCAL_VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct-AWQ

# RAG & Chunking Settings
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=100
MAX_FILE_SIZE_BYTES=10485760
SIMILARITY_THRESHOLD=0.3
MAX_HISTORY_TOKENS=2000

